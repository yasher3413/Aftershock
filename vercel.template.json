{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bash scripts/vercel_install.sh",
  "buildCommand": ". \"$HOME/.cargo/env\" && wasm-pack build crates/aftershock-wasm --release --target web --out-dir ../../web/src/wasm/pkg && cd web && pnpm build && mv dist/index.html dist/app.html",
  "outputDirectory": "web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://__API_HOST__/api/:path*" },
    { "source": "/((?!assets/|app\\.html|favicon|sw\\.js|.*\\.[a-z0-9]+$).*)", "destination": "https://__API_HOST__/page/$1" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/app.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
