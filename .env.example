# Copy to .env and adjust. Every value has a working local default.
DATABASE_URL=postgresql+asyncpg://aftershock:aftershock@localhost:55432/aftershock
REDIS_URL=redis://localhost:6379/0
NHL_API_BASE=https://api-web.nhle.com/v1
NHL_STATS_API_BASE=https://api.nhle.com/stats/rest/en
POLL_LIVE_SECONDS=5
POLL_SCORE_SECONDS=30
SIM_N=20000
SIM_N_BACKFILL=5000
DEMO_MODE=auto
# Optional. Without a key the nightly recap uses the deterministic template.
ANTHROPIC_API_KEY=
RECAP_MODEL=claude-sonnet-5-5
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
# Host port for the Compose Postgres. 55432 avoids clashing with a local install.
POSTGRES_PORT=55432
# Optional web push for big tremors (generate with `aftershock vapid-keys`).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional Discord webhook for magnitude 6+ tremors.
DISCORD_WEBHOOK_URL=
